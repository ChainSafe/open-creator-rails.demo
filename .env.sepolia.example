# Sepolia demo frontend — copy to `.env.sepolia` and fill in values.
# Used by: `pnpm dev:sepolia` and `pnpm build:sepolia` (Vite `--mode sepolia`).
# On Railway / CI: set the same `VITE_*` names in the platform env (not this file).

# ── Required ─────────────────────────────────────────────────────────────────

# Chain profile: must be `sepolia` for Sepolia build.
VITE_CHAIN=sepolia

# Sepolia JSON-RPC (optional — if empty, app uses a public Sepolia RPC default).
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Ponder / OCR indexer GraphQL (your deployed indexer URL).
VITE_INDEXER_URL=https://indexer-api-production-c33d.up.railway.app/graphql

# AssetRegistry contract on Sepolia.
VITE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# ERC-20 with ERC-2612 permit — used when registry owner adds creators in Admin Console.
VITE_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# ── Google Sheets (creator profiles by asset address) ─────────────────────────
# Recommended for Sepolia: sheet is source of truth for names, avatars, gated content.
# See README “Google Sheets” and examples/demo-creator-services-sheet.csv.

# Published CSV (File → Share → Publish to web → CSV). Fallback read if write URL unset.
VITE_DEMO_SERVICES_SHEET_URL=https://docs.google.com/spreadsheets/d/e/YOUR_PUBLISH_ID/pub?output=csv

# Apps Script web app (Deploy → Web app, Execute as: Me, Anyone).
# Same URL for live GET (read all rows) and POST (append/update row after Add Creator).
# Script: examples/google-apps-script-demo-services-append.gs
VITE_DEMO_SERVICES_SHEET_WRITE_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# ── Optional ──────────────────────────────────────────────────────────────────

# Mock API for subscription-gated demo URLs when NOT using sheet gated fields only.
# Omit if creator metadata + gated content come entirely from Google Sheets.
# VITE_MOCK_API_URL=https://your-mock-api.up.railway.app

# WalletConnect / Reown project id (optional; injected wallets work without it).
# VITE_WALLETCONNECT_PROJECT_ID=

# Etherscan-style base URL for address links (optional).
# VITE_BLOCK_EXPLORER_URL=https://sepolia.etherscan.io

# Pre-fill “Add Creator” asset owner in Admin Console (optional; local demo helper).
# VITE_DEMO_TRANSFER_OWNER_ADDRESS=0x0000000000000000000000000000000000000000
