{
  "name": "open-creator-rails.demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "install:all": "pnpm install && pnpm -C open-creator-rails.indexer install",
    "postinstall": "rm -rf open-creator-rails.sdk && git clone --branch deploy/demo --depth 1 https://github.com/ChainSafe/open-creator-rails.sdk.git open-creator-rails.sdk && pnpm -C open-creator-rails.sdk install && pnpm -C open-creator-rails.sdk build",
    "submodule:sdk:update": "git -C open-creator-rails.sdk fetch origin && git -C open-creator-rails.sdk checkout origin/main && git status --short open-creator-rails.sdk",
    "submodule:indexer:update": "git -C open-creator-rails.indexer fetch origin && git -C open-creator-rails.indexer checkout origin/master && git status --short open-creator-rails.indexer",
    "dev:local": "./scripts/dev-local.sh",
    "dev": "vite",
    "dev:anvil": "vite --mode anvil",
    "dev:sepolia": "vite --mode sepolia",
    "dev:mock-api": "node mock-api/server.mjs",
    "build": "tsc -b && vite build",
    "build:anvil": "tsc -b && vite build --mode anvil",
    "build:sepolia": "tsc -b && vite build --mode sepolia",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@open-creator-rails/sdk": "workspace:*",
    "@tanstack/react-query": "^5.95.2",
    "@web3modal/wagmi": "^5.1.11",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "viem": "^2.52.0",
    "wagmi": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "graphql": "^16.14.0",
    "graphql-yoga": "^5.21.0",
    "hono": "^4.12.18",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "ponder": "^0.16.6",
    "sass": "^1.98.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
